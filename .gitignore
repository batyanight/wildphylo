# Build outputs. Every build is reproducible from its config + accession list,
# so the artefacts are not tracked. Provenance IS tracked (see below).
builds/*/*/raw/*
builds/*/*/interim/*
builds/*/*/aligned/*
builds/*/*/tree/*
builds/*/*/subsampled/*
builds/*/*/beast/*
builds/*/*/drt/*
builds/*/*/logs/*

# Tracked deliberately, because a build cannot be audited without them and
# they are small:
!builds/*/*/provenance.json
!builds/*/*/checks.json
!builds/*/*/temporal/*
!builds/*/*/qc/*.tsv
!builds/*/*/raw/*.acc
!builds/*/*/build_comparison.md

# Auspice JSONs are the published artefact. Track the current ones; dated
# archives live in builds/ and are not tracked.
auspice/*.json.gz

# Large alignments and trees
*.fasta
*.fa
*.aln
*.treefile
*.trees
*.tree
*.nexus
*.log.gz
!config/**/*.fasta

# BEAST
*.ops
*.state
*.xml.state

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Snakemake
.snakemake/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Secrets. NCBI API keys belong in the environment, never in a config file.
.env
*.key

# Runtime logs from scripts run outside builds/
logs/
data/raw/

# Runtime output from scripts run outside the builds/ layout. The
# un-ported scripts still write here; once 04/06/09 take explicit paths
# this directory stops being used at all.
logs/
data/

# Generated by tests/fixtures/make_genbank.py; regenerable, not tracked.
tests/fixtures/*.gb

# Clade-scoped builds. The directory level under clades/ must NOT be ignored
# as a whole: git does not descend into an excluded directory, so a negation
# underneath can never rescue anything. Exclude the contents one level deeper
# and whitelist back the small files that make a clade analysis auditable.
#
# The XML is tracked deliberately. It is the complete specification of the
# analysis — model, priors, operators, chain length, alignment — and without it
# a build's provenance covers the dataset but not the model that was fitted.
builds/*/*/clades/*/*
!builds/*/*/clades/*/*.json
!builds/*/*/clades/*/*.md
!builds/*/*/clades/*/*.xml
# The analysis RESULTS, not just its inputs. jumps.tsv and state_through_time.tsv
# are what the transition and lineage-share readings rest on, and they are
# derived from a posterior that is not itself tracked — so if they are dropped,
# the conclusions cannot be checked against anything.
!builds/*/*/clades/*/*.tsv
# ...except the raw per-jump record, which is one row per jump per posterior
# tree: half a million rows and 50 MB for a single clade. The summary derived
# from it is what anyone checking the work needs; the dump is regenerable from
# the posterior and belongs with it, untracked.
builds/*/*/clades/*/jumps.tsv
# The tip-to-state mapping the trait model was fitted with. Part of the model
# specification in the same way the XML is.
!builds/*/*/clades/*/*_traits.txt
