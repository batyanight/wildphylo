# =============================================================================
# Phylodynamics workflow — pathogen-agnostic.
#
#   snakemake --configfile config/pathogen/cdv.yaml --cores 8
#   snakemake --configfile config/pathogen/myvirus.yaml --cores 8 -n   # dry run
#
# Why Snakemake rather than Nextflow: the existing scripts are Python and pass
# state through pandas DataFrames and dataclasses. Snakemake keeps that in one
# language and one process model, and its `checkpoint` mechanism expresses the
# thing this pipeline most needs — a gate that decides at runtime whether the
# expensive Bayesian branch runs at all. Nextflow would be the better call if
# this had to run on a shared HPC scheduler or in multiple languages; it does
# not, yet.
#
# The design principle throughout: every rule writes a provenance record, and
# every rebuild is date-stamped rather than overwriting. A conclusion that
# changes between builds must be traceable to the records that changed.
# =============================================================================

import datetime as dt
import json
import re
import sys
from pathlib import Path

from wildphylo import config as cfgmod
from wildphylo.layout import BuildLayout

# --- configuration ----------------------------------------------------------

if not config:
    raise WorkflowError(
        "No config given. Run with --configfile config/pathogen/<name>.yaml"
    )

# Snakemake's --configfile loads the YAML itself and bypasses wildphylo.config.load(),
# so the path it came from has to be recovered here. Scripts are passed this
# path and re-validate independently, which keeps them runnable standalone.
config["_path"] = str(Path(workflow.configfiles[0]).resolve())

errors, warnings = cfgmod.validate(config)
if errors:
    raise WorkflowError(
        "Config is not usable:\n" + "\n".join(f"  - {e}" for e in errors))
for w in warnings:
    logger.warning(f"config: {w}")

PATHOGEN = config["id"]
# The build date is computed fresh on every invocation unless pinned. That bit
# once: a run started before midnight could not be resumed after it, because
# the output directory had moved and every completed step looked missing.
# Pin it on the command line to resume, or in the config to make a build
# reproducible rather than dependent on when it was typed:
#     snakemake ... --config build_date=20260919
BUILD = str(config.get("build_date") or dt.date.today().strftime("%Y%m%d"))

# Every build is namespaced by date. Old builds are never overwritten, which is
# what makes "the TMRCA moved" a debuggable event rather than a mystery.
# L is the only place that knows where a file lives inside the build: rules ask
# it for paths and never assemble them (src/wildphylo/layout.py).
L = BuildLayout.from_config(config, BUILD)
# Every step takes the config and the build directory and derives its own
# input and output paths from BuildLayout; rules still declare them so the DAG
# is explicit. Only wildcards (locus, seed, rep) and per-rule policy travel on
# the command line.
STEP = "--config " + config["_path"] + " --build-dir " + str(L.root)

# Warn if a build for a DIFFERENT date already exists and this one is unpinned:
# almost always someone resuming across midnight.
if not config.get("build_date"):
    _existing = sorted(
        d.name for d in L.pathogen_dir().glob("2*")
        if d.is_dir() and d.name != BUILD) if L.pathogen_dir().is_dir() else []
    if _existing:
        logger.warning(
            f"{L.pathogen_dir()}/ already contains {', '.join(_existing[-3:])} "
            f"but this run will write to {BUILD}. To resume an earlier build "
            f"instead, add:  --config build_date={_existing[-1]}")

# Loci. An unsegmented pathogen declares `locus`; a segmented one declares
# `loci` and every rule below fans out over the analysed ones. Treating the
# single-locus case as a list of length one keeps one code path rather than two.
if "loci" in config:
    LOCI = [l["name"] for l in config["loci"] if l.get("analyse")]
    LOCUS_CFG = {l["name"]: l for l in config["loci"]}
else:
    LOCI = [config["locus"]["name"]]
    LOCUS_CFG = {config["locus"]["name"]: config["locus"]}

_BUILD_NAME = config["nextstrain"]["build_name"]
# With several loci there is one Auspice dataset per locus, and the filename
# becomes the URL path (docs/NEXTSTRAIN.md). With one locus the bare name is
# kept, so an existing published URL does not move.
# With one locus every path in the auspice rule is concrete, so there is no
# wildcard to resolve; with several, all of them carry {locus}. Mixing the two
# is what Snakemake rejects ("not all output, log and benchmark files ...
# contain the same wildcards"), so _L switches them together.
_L = "{locus}" if len(LOCI) > 1 else LOCI[0]
AUSPICE_JSON = L.auspice_dataset(_BUILD_NAME, "{locus}" if len(LOCI) > 1 else None)
AUSPICE_LOG = L.log(f"09_auspice_{_L}")

# IQ-TREE ships under three names depending on version and channel: `iqtree`
# (v1 and some v2 builds), `iqtree2`, and `iqtree3` since 2025. Hardcoding one
# fails at runtime with "command not found" — invisible until the rule actually
# runs, which on a large alignment can be hours in. Resolve it once, here, and
# let config override.
import shutil as _shutil

def _resolve_iqtree() -> str:
    named = (config.get("tree") or {}).get("binary")
    if named:
        return named
    for candidate in ("iqtree3", "iqtree2", "iqtree"):
        if _shutil.which(candidate):
            return candidate
    # Nothing found. Return the modern default so the DAG still builds (a dry
    # run must work without the tools installed); the rule will fail clearly
    # if it is ever executed.
    return "iqtree2"

IQTREE = _resolve_iqtree()

SEGMENTED = (config.get("virus") or {}).get("segmented", False)
CONGRUENCE = (SEGMENTED and len(LOCI) > 1
              and (config.get("segments") or {}).get("congruence_gate", True))

# Discrete-trait analysis. When it is on, BEAST writes a SECOND tree file
# carrying the reconstructed ancestral states, and a second gate applies: the
# tip-label randomisation test. A DTA always produces a transition table, so
# without that gate an unsupported table reaches publication looking identical
# to a supported one.
_DT = (config.get("beast") or {}).get("discrete_trait") or {}
DTA = bool(_DT.get("enabled"))
TRAIT_SIGNAL = DTA and (_DT.get("signal_gate", True))


def locus_opt(wildcards, key, default=None):
    """Per-locus setting, falling back to the pathogen-level one."""
    lc = LOCUS_CFG.get(wildcards.locus, {})
    if key in lc and lc[key] is not None:
        return lc[key]
    for section in ("dates", "beast"):
        if key in config.get(section, {}):
            return config[section][key]
    return default


wildcard_constraints:
    seed = r"\d+",
    rep = r"\d+",
    locus = "|".join(re.escape(l) for l in LOCI) if LOCI else r"[A-Za-z0-9_-]+",


# --- targets ----------------------------------------------------------------

def final_targets(wildcards):
    """
    What gets built depends on the temporal-signal gate, which is resolved
    after the gate runs rather than when the DAG is first drawn. With several
    loci the verdict is per locus: one segment may pass while another fails,
    and that is a finding rather than an inconsistency.
    """
    targets = []
    verdicts = {}
    for locus in LOCI:
        gate = checkpoints.temporal_gate.get(locus=locus).output.report
        verdicts[locus] = json.loads(Path(gate).read_text())["verdict"]

    on_fail = config.get("temporal_signal", {}).get("on_fail", "stop")
    passing = [l for l, v in verdicts.items()
               if not (v == "fail" and on_fail == "stop")]
    blocked = [l for l in LOCI if l not in passing]
    if blocked:
        logger.warning(
            f"Temporal signal gate returned FAIL for: {', '.join(blocked)}. "
            "The Bayesian and Nextstrain steps for those loci are being "
            "skipped deliberately. Running BEAST on data with no clock signal "
            "returns a confident posterior for a rate that is not "
            "identifiable. To override, set temporal_signal.on_fail: warn."
        )
    if not passing:
        return targets

    build = config["nextstrain"]["build_name"]
    if len(LOCI) > 1:
        targets += expand(str(L.auspice_dataset(build, "{locus}")), locus=passing)
    else:
        targets.append(str(L.auspice_dataset(build)))
    targets += expand(str(L.convergence_report("{locus}")), locus=passing)
    if TRAIT_SIGNAL:
        targets += expand(str(L.trait_signal_report("{locus}")), locus=passing)
    if config["beast"].get("date_randomisation", {}).get("enabled"):
        targets += expand(str(L.drt_summary("{locus}")), locus=passing)
    return targets


def gate_targets(_wildcards=None):
    """
    Everything reachable WITHOUT consulting a checkpoint. Kept separate because
    `checkpoints.x.get()` raises as soon as it hits an unfinished checkpoint,
    abandoning the rest of the function -- so with several loci only the first
    one's branch would get scheduled and the others would run serially for no
    reason. Listing the gates statically lets all of them run at once.
    """
    t = [str(L.provenance())]
    t += expand(str(L.alignment_qc("{locus}")), locus=LOCI)
    t += expand(str(L.temporal_report("{locus}")), locus=LOCI)
    t += expand(str(L.temporal_plot("{locus}")), locus=LOCI)
    if CONGRUENCE:
        t.append(str(L.congruence_report()))
    return t


rule all:
    input:
        gates = gate_targets,
        downstream = final_targets


# --- 1. acquisition ---------------------------------------------------------

rule fetch:
    """
    Pull records from GenBank. Date-stamped and cached: re-running does not
    re-download, and an old pull is never silently replaced by a new one.
    """
    output:
        gb  = L.raw_records(),
        acc = L.accession_snapshot(),
    log: L.log("01_fetch")
    shell:
        # Email and API key come from the environment (NCBI_EMAIL,
        # NCBI_API_KEY), never from the config: they are personal credentials,
        # not analysis parameters, and a config file gets committed.
        "wildphylo fetch records " + STEP + " 2>&1 | tee {log}"


rule curate:
    """
    Normalise hosts, parse dates, extract the locus. Nothing is dropped
    silently: exclusions carry a reason and ambiguities go to needs_review.
    """
    input:
        gb = rules.fetch.output.gb,
        hosts = config["hosts"]["table"],
    output:
        meta    = L.metadata(),
        fasta   = expand(str(L.locus_sequences("{locus}")), locus=LOCI),
        anchors = expand(str(L.anchors("{locus}")), locus=LOCI),
        review  = L.needs_review(),
        flagged = L.flagged(),
        excl    = L.exclusions(),
    log: L.log("02_curate")
    shell:
        "wildphylo curate metadata " + STEP + " 2>&1 | tee {log}"


rule review_gate:
    """
    Hard stop if needs_review is non-empty and unacknowledged. Ambiguous host
    labels are the input to the host-transition analysis; letting them through
    unreviewed is how a result becomes a curation artefact.
    """
    input: review = rules.curate.output.review
    output: marker = L.review_marker()
    params:
        accept = ("--accept-unreviewed" if config.get("accept_unreviewed", False) else ""),
    shell:
        "wildphylo curate review " + STEP + " {params.accept}"


# --- 2. alignment and ML tree ----------------------------------------------

rule align:
    """
    Align the analysis sequences together with the reference anchors.

    Anchors carry a non-numeric date field, so every downstream parser treats
    them as undated and drops them from the clock, the subsample and the trait
    analysis — while they stay in the alignment and the tree, which is the only
    way a clade can be named. The anchors file is always written, possibly
    empty, so this input is fixed.
    """
    input:
        fasta   = L.locus_sequences("{locus}"),
        anchors = L.anchors("{locus}"),
        ok      = rules.review_gate.output,
    output: aln = L.alignment("{locus}")
    params: args = config["alignment"]["mafft_args"]
    threads: 4
    log: L.log("03_align_{locus}")
    shell:
        "cat {input.fasta} {input.anchors} > {output.aln}.tmp && "
        "mafft {params.args} --thread {threads} {output.aln}.tmp > {output.aln}"
        " 2> {log} && rm -f {output.aln}.tmp"


rule alignment_qc:
    input: aln = rules.align.output.aln, meta = rules.curate.output.meta
    output:
        tsv = L.alignment_qc("{locus}"),
        png = L.alignment_qc_plot("{locus}"),
    log: L.log("04_qc_{locus}")
    shell:
        "wildphylo align qc " + STEP + " --locus {wildcards.locus} 2>&1 | tee {log}"


rule ml_tree:
    input: aln = rules.align.output.aln, qc = rules.alignment_qc.output.tsv
    output: tree = L.ml_tree("{locus}")
    params:
        model = config["tree"]["model"],
        # -B and -alrt are each roughly a doubling of runtime on a large
        # alignment. Setting either to 0 or null omits the flag entirely, which
        # is how you get a cheap first pass to prove the chain works before
        # committing a night of compute to the real thing.
        ufboot = (f"-B {config['tree']['ufboot']}"
                  if config["tree"].get("ufboot") else ""),
        alrt = (f"-alrt {config['tree']['alrt']}"
                if config["tree"].get("alrt") else ""),
        # tree.fast: IQ-TREE's -fast search, for smoke builds only.
        fast = "-fast" if config["tree"].get("fast") else "",
        seed = config["tree"].get("seed", cfgmod.DEFAULT_TREE_SEED),
        extra = config["tree"].get("extra_args", ""),
        pre = str(L.ml_tree_prefix("{locus}")),
        iqtree = IQTREE,
    threads: 8
    log: L.log("03_tree_{locus}")
    shell:
        "{params.iqtree} -s {input.aln} -m {params.model} {params.ufboot}"
        " {params.alrt} {params.fast} {params.extra} -seed {params.seed}"
        " -T {threads} --prefix {params.pre}"
        " -redo 2>&1 | tee {log}"


# --- 3. the gate ------------------------------------------------------------

checkpoint temporal_gate:
    """
    Does this dataset support tip-dating?

    This is the rule that did not exist before. Previously the clock prior was
    written into a BEAST XML with no check that a clock was estimable, and the
    root-to-tip regression was a manual TempEst step a user could skip. A
    reversed time axis once survived 10^8 MCMC states in this project; a
    negative slope here catches that in seconds.
    """
    input:
        tree = rules.ml_tree.output.tree,
        meta = rules.curate.output.meta,
    output:
        report = L.temporal_report("{locus}"),
        plot   = L.temporal_plot("{locus}"),
        md     = L.temporal_report_md("{locus}"),
    log: L.log("04b_temporal_{locus}")
    shell:
        "wildphylo gates temporal " + STEP + " --locus {wildcards.locus} 2>&1 | tee {log}"
        # No --exit-nonzero-on-fail: a FAIL verdict must still leave its report
        # on disk. final_targets reads the verdict and declines to schedule the
        # Bayesian branch.


# --- 3b. segment congruence (segmented pathogens only) ---------------------

if CONGRUENCE:

    rule congruence:
        """
        Compare segment topologies before anything downstream treats them as
        one history.

        Three failures follow from concatenating reassorting segments: the
        joined tree matches no segment's real ancestry, one clock is fitted to
        segments with genuinely different TMRCAs, and -- the one that matters
        most here -- a reassortant taxon sits among different relatives
        depending on the segment, so it manufactures a host transition that
        reflects reassortment rather than transmission. Since host-jump
        inference is the point of this pipeline, that is a false positive in
        the primary result. See docs/DECISIONS.md DR-007.
        """
        input:
            trees = expand(str(L.ml_tree("{locus}")), locus=LOCI),
        output:
            json = L.congruence_report(),
            md   = L.congruence_md(),
            tsv  = L.reassortant_candidates(),
        log: L.log("05b_congruence")
        shell:
            "wildphylo gates congruence " + STEP + " 2>&1 | tee {log}"


# --- 4. subsample and Bayesian inference -----------------------------------

rule subsample:
    input:
        aln = rules.align.output.aln,
        meta = rules.curate.output.meta,
        gate = L.temporal_report("{locus}"),
    output:
        aln  = L.subsample("{locus}"),
        meta = L.subsample_metadata("{locus}"),
    params:
        target = config["subsample"]["target_tips"],
        seed = config["subsample"]["seed"],
        bin = config["subsample"]["year_bin"],
    log: L.log("06_subsample_{locus}")
    shell:
        "wildphylo beast subsample " + STEP + " --locus {wildcards.locus} --mode global"
        " --target {params.target} --year-bin {params.bin} --seed {params.seed}"
        " 2>&1 | tee {log}"


rule beast_xml:
    """
    Write the BEAST XML. If clock_rate_prior is null in the config, the prior
    is centred on the root-to-tip slope measured from this dataset rather than
    inherited from another pathogen.
    """
    input:
        aln = rules.subsample.output.aln,
        meta = rules.subsample.output.meta,
        gate = L.temporal_report("{locus}"),
    output:
        xml = L.beast_xml("{locus}", "{seed}"),
        traits = L.beast_traits("{locus}", "{seed}"),
    log: L.log("07_xml_{locus}_seed{seed}")
    shell:
        "wildphylo beast xml " + STEP + " --locus {wildcards.locus} --seed {wildcards.seed}"
        " 2>&1 | tee {log}"


# The ancestral-state tree file is a real output and is declared as one. A file
# BEAST writes but the workflow does not know about cannot be re-run, cleaned or
# invalidated, and goes stale without anyone noticing -- which for a trait file
# means the signal gate silently tests a previous run's reconstruction.
# The rule is written twice because Snakemake output lists are static; the shell
# command is shared so the two cannot drift.
_BEAST_SHELL = (
    "beast -seed {wildcards.seed} -threads {threads} -overwrite"
    " -prefix " + str(L.beast_chain_dir("{wildcards.locus}", "{wildcards.seed}")) + "/"
    " {input.xml} 2>&1 | tee {log}")

if DTA:
    rule beast_run:
        input: xml = rules.beast_xml.output.xml
        output:
            log_ = L.beast_log("{locus}", "{seed}"),
            trees = L.beast_trees("{locus}", "{seed}"),
            trait_trees = L.beast_trait_trees("{locus}", "{seed}"),
        threads: 4
        resources: runtime = 10080   # minutes; these are multi-day runs
        log: L.log("08_beast_{locus}_seed{seed}")
        shell: _BEAST_SHELL
else:
    rule beast_run:
        input: xml = rules.beast_xml.output.xml
        output:
            log_ = L.beast_log("{locus}", "{seed}"),
            trees = L.beast_trees("{locus}", "{seed}"),
        threads: 4
        resources: runtime = 10080   # minutes; these are multi-day runs
        log: L.log("08_beast_{locus}_seed{seed}")
        shell: _BEAST_SHELL


rule convergence:
    """
    ESS and between-chain agreement, checked automatically. A chain that has
    not converged must not silently become a published number.
    """
    input:
        logs = expand(str(L.beast_log("{{locus}}", "{seed}")),
                      seed=config["beast"]["seeds"]),
    output:
        json = L.convergence_report("{locus}"),
        combined = L.combined_log("{locus}"),
    log: L.log("08b_convergence_{locus}")
    shell:
        "wildphylo gates convergence " + STEP + " --locus {wildcards.locus} 2>&1 | tee {log}"


if TRAIT_SIGNAL:
    rule trait_signal:
        """
        Tip-label randomisation (Parker, Rambaut & Pybus 2008).

        A discrete-trait analysis always returns a transition table. This asks
        the prior question -- whether the tip states are associated with the
        phylogeny at all -- by shuffling the host labels across the tips of the
        posterior trees already sampled and recomputing the association
        statistics. If the real labelling is no more clustered than a shuffled
        one, the transition table describes the label distribution rather than
        transmission, and nothing in it should be reported.

        Uses topology and tip labels only, never BEAST's reconstructed
        ancestral states: those are the thing under test.

        Cheap. Minutes on files that already exist, not another chain.
        """
        input:
            trees = expand(
                str(L.beast_trait_trees("{{locus}}", "{seed}")),
                seed=config["beast"]["seeds"]),
            conv = rules.convergence.output.json,
        output:
            json = L.trait_signal_report("{locus}"),
            md   = L.trait_signal_md("{locus}"),
        log: L.log("08e_trait_signal_{locus}")
        shell:
            "wildphylo gates trait-signal " + STEP + " --locus {wildcards.locus}"
            " 2>&1 | tee {log}"


rule mcc_tree:
    input:
        trees = expand(str(L.beast_trees("{{locus}}", "{seed}")),
                       seed=config["beast"]["seeds"]),
        conv = rules.convergence.output.json,
    output: mcc = L.mcc_tree("{locus}")
    params: burnin = lambda w: int(config["beast"]["burnin_fraction"] * 100)
    log: L.log("08c_mcc_{locus}")
    shell:
        # BEAST2 syntax: logcombiner detects tree files itself (no -trees flag),
        # and treeannotator takes -height, not BEAST1's -heights.
        "logcombiner -burnin {params.burnin} -log {input.trees}"
        " -o " + str(L.combined_trees("{wildcards.locus}")) + " && "
        "treeannotator -burnin 0 -height median "
        + str(L.combined_trees("{wildcards.locus}")) + " {output.mcc} 2>&1 | tee {log}"


# --- 5. date-randomisation test --------------------------------------------

rule drt_xml:
    input: aln = rules.subsample.output.aln, meta = rules.subsample.output.meta
    output: xml = L.drt_xml("{locus}", "{rep}")
    shell:
        "wildphylo beast xml " + STEP + " --locus {wildcards.locus} --rep {wildcards.rep}"


rule drt_run:
    input: xml = rules.drt_xml.output.xml
    output: log_ = L.drt_log("{locus}", "{rep}")
    threads: 2
    shell: "beast -seed 1{wildcards.rep} -threads {threads} -overwrite {input.xml}"


rule drt_summary:
    """
    The formal temporal-signal test: the real clock-rate HPD must not overlap
    the HPDs from date-randomised replicates. Overlap means the rate is being
    driven by tree shape, not by time.
    """
    input:
        real = rules.convergence.output.combined,
        reps = expand(str(L.drt_log("{{locus}}", "{rep}")),
                      rep=range(1, config["beast"]["date_randomisation"]["replicates"] + 1)),
    output:
        json = L.drt_summary("{locus}"),
        png  = L.drt_plot("{locus}")
    log: L.log("08d_drt_{locus}")
    shell:
        "wildphylo gates drt " + STEP + " --locus {wildcards.locus} 2>&1 | tee {log}"


# --- 6. Nextstrain build ----------------------------------------------------

rule auspice:
    input:
        mcc  = L.mcc_tree(_L),
        meta = L.subsample_metadata(_L),
        aln  = L.subsample(_L),
        conv = L.convergence_report(_L),
        full_meta = rules.curate.output.meta,
        # Listed as an input so a build cannot be published without the trait
        # having been tested. The gate's own exit code stops the run on a
        # failure; this makes the dependency visible in the DAG as well.
        **({"trait_signal": L.trait_signal_report(_L)}
           if TRAIT_SIGNAL else {}),
    output: json = AUSPICE_JSON
    log: AUSPICE_LOG
    shell:
        # The gate verdicts travel with the published build: with --build-dir
        # the step picks up every gate report that exists. A trait colouring
        # that failed its signal test renders identically to one that passed,
        # and the people reading a published tree did not run the pipeline.
        "wildphylo auspice dataset " + STEP + " --locus " + _L + " 2>&1 | tee {log}"


rule publish:
    """
    Compare against the previous build before publishing. A TMRCA that has
    moved several years, or a dataset that has lost sequences, is a curation
    regression until proven otherwise -- not a new finding.
    """
    input: json = rules.auspice.output.json
    output: report = L.build_comparison()
    log: L.log("12_compare_builds")
    shell:
        "wildphylo gates compare " + STEP + " 2>&1 | tee {log}"


# --- provenance -------------------------------------------------------------

rule provenance:
    """
    One record per build: config hash, tool versions, accession list, git
    commit. Without this, a rebuilt tree that disagrees with the last one is
    unresolvable.
    """
    input: acc = rules.fetch.output.acc
    output: json = L.provenance()
    run:
        import hashlib, subprocess, platform
        cfg_bytes = Path(config["_path"]).read_bytes()
        def ver(cmd):
            try:
                return subprocess.run(cmd, capture_output=True, text=True,
                                      timeout=20).stdout.split("\n")[0]
            except Exception:
                return "unavailable"
        rec = {
            "pathogen": PATHOGEN,
            "build_date": BUILD,
            "config_path": config["_path"],
            "config_sha256": hashlib.sha256(cfg_bytes).hexdigest(),
            "config_warnings": warnings,
            "n_accessions": sum(1 for _ in open(input.acc)),
            "platform": platform.platform(),
            "python": platform.python_version(),
            "tools": {"mafft": ver(["mafft", "--version"]),
                      IQTREE: ver([IQTREE, "--version"]),
                      "beast": ver(["beast", "-version"])},
            "git_commit": ver(["git", "rev-parse", "HEAD"]),
        }
        Path(output.json).write_text(json.dumps(rec, indent=2))
